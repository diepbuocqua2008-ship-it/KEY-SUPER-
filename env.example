NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
DB_FILE=./data/keyvn.sqlite

# Public shop identity
SHOP_NAME=KEYVN
CURRENCY=VND

# SePay Webhook: choose HMAC-SHA256 in SePay dashboard (recommended).
# Paste the webhook secret key here. Do not commit .env.
SEPAY_WEBHOOK_SECRET=
# Optional: restrict webhook to your receiving bank account number.
SEPAY_BANK_ACCOUNT_NUMBER=
# Optional: restrict gateway name only if payload naming is stable for your bank.
SEPAY_REQUIRE_INCOMING=true

# VietQR details used to display the transfer QR for a deposit.
# Get the correct bank BIN and account details from your bank / VietQR provider.
BANK_BIN=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2

# Admin creation uses CLI script and prompts for password; no default admin credentials.
